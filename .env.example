# Google AI Studio Gemini API Key
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Model Selection (e.g. gemini-2.5-pro, gemini-2.5-flash)
DEFAULT_MODEL=gemini-2.5-pro

# Timeout for individual LLM generation requests (milliseconds)
GEMINI_TIMEOUT_MS=60000

# Maximum retry attempts for transient 429/5xx errors
GEMINI_MAX_RETRIES=3

# Local Server Port
PORT=3000

# Environment Mode: development | test | production
NODE_ENV=development

# =============================================================
# PERSISTENCE (V2.1 - SUPABASE / POSTGRESQL)
# =============================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
